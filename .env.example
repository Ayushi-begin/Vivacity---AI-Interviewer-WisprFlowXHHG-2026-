# Copy to .env and fill in real values. Never commit .env.

# --- Database (Neon) ---
# Paste the connection string from the Neon console as-is. The app converts it
# for asyncpg (strips sslmode/channel_binding, enables SSL, handles -pooler hosts).
DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_ECHO=false

# --- JWT ---
# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password reset ---
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# --- OpenAI ---
# Without a key the app still starts, but the interview endpoints return 503.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- OAuth ---
# A provider is disabled (its /login returns 503) while its client id is empty.
# Register these callback URLs with each provider:
#   {OAUTH_REDIRECT_BASE_URL}/auth/google/callback
#   {OAUTH_REDIRECT_BASE_URL}/auth/github/callback

# --- OAuth: Google (console.cloud.google.com → Google Auth Platform → Clients) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub (github.com/settings/developers → OAuth Apps) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- URLs ---
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
